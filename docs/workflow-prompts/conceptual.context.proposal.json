{
  "workflow": "conceptual",
  "stage": "candidate_authoring",
  "status": "approved_design; implementation_deferred",
  "modes": [
    "one_shot",
    "tool_assisted"
  ],
  "shape_reuse": "References document exact accepted evidence shapes. Bind variables within Conceptual; no global variable catalog or dependency on running Analysis. Resolve each referenced schema with the definitions in its source document.",
  "selection": "Eleven workflow-local variables. The seven foundational shapes remain unchanged. Conceptual directories contain all eligible natural keys; detail variables retain complete records. Authors choose inclusion. The One-shot default uses nine full-evidence values; Tool-assisted uses ingestion_mapping inline and ten optional readers. Variable values have no function arguments; compact list readers optionally filter by supporting physical Object keys.",
  "schema_origin": "Existing ConceptualObjectRecord/ConceptualRelationshipRecord plus compact projections of their exact natural-key fields. No new record columns or live database inspection.",
  "example_note": "Synthetic existing input, not generated output. Assumes scoped GDS/WAREHOUSE/MAIN/bronze Customers and Orders plus active Conceptual-applicable assertion order_customer_reference. Sample type values are illustrative nonblank codes, not new enums. True locks describe existing saved records.",
  "variables": {
    "source_context": {
      "description": "Unique contributing source Connections and business context.",
      "shape_reference": "analysis.context-and-tools.json#/variables/source_context/value_schema"
    },
    "gds_context": {
      "description": "Unique GDS Connection/zone placements for the selected Objects; empty for Source-only scope.",
      "shape_reference": "analysis.context-and-tools.json#/variables/gds_context/value_schema"
    },
    "object_context": {
      "description": "Selected physical Objects with current saved descriptions.",
      "shape_reference": "analysis.context-and-tools.json#/variables/object_context/value_schema"
    },
    "object_attribute_context": {
      "description": "Eligible Attributes grouped by physical Object, with current saved descriptions, types, flags, and Profiles.",
      "shape_reference": "analysis.context-and-tools.json#/variables/object_attribute_context/value_schema"
    },
    "ingestion_mapping": {
      "description": "Registered Object-only source-to-selected-target links.",
      "shape_reference": "analysis.context-and-tools.json#/variables/ingestion_mapping/value_schema"
    },
    "object_relationship_context": {
      "description": "Existing applied relationships grouped by each scoped physical Object. Incoming matches the to-Object; outgoing matches the from-Object. Include groups with empty arrays. Each relationship retains all 17 approved endpoint/kind/confidence/basis/status/lock fields and excludes validation fields.",
      "shape_reference": "analysis.context-and-tools.json#/variables/object_relationship_context/value_schema"
    },
    "modeling_assertions": {
      "description": "Active governed Conceptual-applicable assertion records from active documents within authorized Model/source scope; includes applicable Model-wide assertions.",
      "shape_reference": "analysis.context-and-tools.json#/variables/modeling_assertions/value_schema"
    },
    "conceptual_object_list": {
      "description": "Compact directory of all existing eligible Conceptual record identities in the frozen Model. Natural-key fields only; no descriptions, types, supports, status, or locks. Use the corresponding detail variable or reader to interpret a record. [] means known empty; null means the applied Conceptual section is unavailable.",
      "value_schema": {
        "$defs": {
          "ConceptualObjectKey": {
            "type": "object",
            "properties": {
              "conceptual_object_name": {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "\\S",
                "title": "Conceptual Object Name",
                "type": "string"
              }
            },
            "required": [
              "conceptual_object_name"
            ],
            "additionalProperties": false
          }
        },
        "anyOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ConceptualObjectKey"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "example_value": [
        {
          "conceptual_object_name": "Customer"
        },
        {
          "conceptual_object_name": "Order"
        }
      ]
    },
