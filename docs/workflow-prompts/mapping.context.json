  "selection": "Every variable and reader is workflow-local and author-selected. Defaults do not force inclusion. No hidden context append. Use restricted Jinja, render once; values are data.",
  "control_handles": "target_ref/system_ref are retained opaque output-control handles, not database IDs. All evidence joins use actual nominal keys.",
  "default_inline": {
    "one_shot": [
      "mapping_route",
      "operation",
      "target_metadata",
      "source_evidence",
      "existing_mapping",
      "authoring_policy",
      "readiness",
      "source_system",
      "object_output_template",
      "attribute_output_template"
    ],
    "tool_assisted": [
      "mapping_route",
      "operation",
      "authoring_policy",
      "readiness",
      "source_system",
      "object_output_template",
      "attribute_output_template"
    ]
  },
  "preserved_output_schema": {
    "$defs": {
      "JsonObject": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "minProperties": 1,
        "type": "object"
      },
      "JsonValue": {},
      "MappingAttributeCandidate": {
        "additionalProperties": false,
        "properties": {
          "modeled_attribute_name": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Modeled Attribute Name",
            "type": "string"
          },
          "attribute_mapping_transformation_document": {
            "$ref": "#/$defs/JsonObject"
          }
        },
        "required": [
          "modeled_attribute_name",
          "attribute_mapping_transformation_document"
        ],
        "title": "MappingAttributeCandidate",
        "type": "object"
      },
      "MappingObjectCandidate": {
        "additionalProperties": false,
        "properties": {
          "object_dependency_order": {
            "minimum": 0,
            "title": "Object Dependency Order",
            "type": "integer"
          },
          "mapping_transformation_document": {
            "$ref": "#/$defs/JsonObject"
          }
        },
        "required": [
          "object_dependency_order",
          "mapping_transformation_document"
        ],
        "title": "MappingObjectCandidate",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Agent output: transformation content only; identity comes from the frozen run.",
    "properties": {
      "schema_version": {
        "const": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "object_mapping": {
        "anyOf": [
          {
            "$ref": "#/$defs/MappingObjectCandidate"
          },
          {
            "type": "null"
          }
        ]
      },
      "attribute_mappings": {
        "items": {
          "$ref": "#/$defs/MappingAttributeCandidate"
        },
        "maxItems": 5000,
        "title": "Attribute Mappings",
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "object_mapping",
      "attribute_mappings"
    ],
    "title": "CompleteMappingCandidateV1",
    "type": "object"
  }
