{
  "workflow": "validation",
  "stage": "validation_generation",
  "status": "implemented runtime contract",
  "modes": [
    "tool_assisted"
  ],
  "source": "web_app/backend/gds_workbench_api/features/workflows/authoring",
  "selection": "Validation remains Model/System-owned. It consumes Mapping and Code for schema-qualified modeled Entities.",
