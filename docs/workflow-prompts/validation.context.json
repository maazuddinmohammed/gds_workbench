                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Attribute Inferred Data Type"
              },
              "attribute_nullability": {
                "title": "Attribute Nullability",
                "type": "boolean"
              },
              "attribute_ordinal_position": {
                "exclusiveMinimum": 0,
                "title": "Attribute Ordinal Position",
                "type": "integer"
              },
              "attribute_description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
