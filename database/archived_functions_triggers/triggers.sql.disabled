CREATE CONSTRAINT TRIGGER validate_effective_graph
AFTER INSERT ON workflow.effective_graph_validation_queue
DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
EXECUTE FUNCTION workflow.assert_effective_graph();
