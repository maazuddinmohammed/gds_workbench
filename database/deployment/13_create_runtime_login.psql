\set ON_ERROR_STOP on

-- psql-only runtime-login provisioning. This file never stores a password.
-- Run it once as the Azure PostgreSQL server administrator.

BEGIN;

CREATE ROLE gds_mcp_runtime
    LOGIN
    NOINHERIT
    NOSUPERUSER
    NOCREATEDB
    NOCREATEROLE
    NOREPLICATION
    NOBYPASSRLS;

GRANT gds_app_write TO gds_mcp_runtime;

DO $grant_database_connect$
BEGIN
    EXECUTE format(
        'GRANT CONNECT ON DATABASE %I TO gds_mcp_runtime',
        current_database()
    );
END;
$grant_database_connect$;

COMMIT;

-- \password prompts twice and does not put the password in this file or the
-- shell command. If it is interrupted, the login remains passwordless and
-- cannot authenticate; rerun only this \password command from psql.
\password gds_mcp_runtime
