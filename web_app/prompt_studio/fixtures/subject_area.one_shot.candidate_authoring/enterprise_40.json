  "output_schema": {
    "$defs": {
      "_AreaAnswer": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Business domain name, such as Sales or Human Resources.",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name",
            "type": "string"
          },
          "definition": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "What the area covers, in one or two sentences. Required for a new area; omit to keep a saved one.",
            "title": "Definition"
          },
          "tables": {
            "description": "Every table that belongs in this area. The list replaces the area's saved tables; locked tables stay. A table may belong to several areas.",
            "items": {
              "description": "A table id from table_index, such as t1.",
              "pattern": "^t[1-9][0-9]{0,5}$",
              "type": "string"
            },
            "maxItems": 50000,
            "title": "Tables",
            "type": "array"
          }
        },
        "required": [
          "name",
          "tables"
        ],
        "title": "_AreaAnswer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "areas": {
        "description": "New areas, and saved areas to change. Unlisted saved areas stay as saved.",
        "items": {
          "$ref": "#/$defs/_AreaAnswer"
        },
        "maxItems": 1000,
        "title": "Areas",
        "type": "array"
      },
      "unassigned": {
        "description": "Tables with no business data, such as technical, staging or log tables. Every table is in an area or here.",
        "items": {
          "description": "A table id from table_index, such as t1.",
          "pattern": "^t[1-9][0-9]{0,5}$",
          "type": "string"
        },
        "maxItems": 50000,
        "title": "Unassigned",
        "type": "array"
      },
      "retire": {
        "description": "Saved area names to mark inactive with their tables. Nothing is deleted.",
        "items": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "maxItems": 1000,
        "title": "Retire",
        "type": "array"
      }
    },
    "required": [
      "areas",
      "unassigned",
      "retire"
    ],
    "title": "_SubjectAreaAnswer",
    "type": "object",
    "description": "Group every table in table_index into Subject Areas: broad business domains, each designed by one Logical Build call. Cite tables by table_index id. Return new areas and saved areas you change; a listed area's tables replace its saved unlocked tables from table_index, and its other tables stay. Put each remaining table in unassigned. Retire saved areas by name; nothing is deleted. On repair, fix every context.repair.validation_issues entry and return the complete corrected answer, not a patch."
  },
