        "record": {
          "context_record_id": "0e64bde2-9c4e-47f2-85f8-a9f4d6b011ce",
          "context_group_name": "Shipment feed",
          "context_type_name": "Mapping Requirement",
          "source_reference": null,
          "context_text": "Keep every dispatch in the current orchestration batch. Depots loaded in earlier batches remain eligible. Missing depots keep the dispatch with a null role key. dispatch_detail contains multiple lines per dispatch_no and load_batch. Keep lines with status POSTED, sum quantity * unit_price - discount by dispatch_no within the batch, then left join that single total to the dispatch. Missing line totals give 0. ReferenceText is the total formatted as STRING. Do not deduplicate lines; identical lines are distinct. Exclude CANCELLED lines before summing."
        }
      },
