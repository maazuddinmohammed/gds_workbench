# Development example. The application does not automatically load this file.
GDS_ENVIRONMENT=local
GDS_AUTH_MODE=dev

# Secret-bearing values intentionally remain blank. Inject them locally or through
# Azure App Service settings; never commit their values.
GDS_DATABASE_DSN=
GDS_CURSOR_SIGNING_KEY=

GDS_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
GDS_REQUIRE_HTTPS=false
GDS_SCHEMA_VERSION=1.0.0

GDS_DATABASE_POOL_MIN=1
GDS_DATABASE_POOL_MAX=5
GDS_DATABASE_POOL_TIMEOUT_SECONDS=10
GDS_DATABASE_CONNECTION_BUDGET=100
GDS_DATABASE_CONNECTION_HEADROOM=20
GDS_REQUEST_TIMEOUT_SECONDS=120
WEB_CONCURRENCY=2
PORT=8000

# Production changes:
# GDS_ENVIRONMENT=production
# GDS_AUTH_MODE=azure_easy_auth
# GDS_REQUIRE_HTTPS=true
# GDS_MCP_ALLOWED_HOSTS=<app-name>.azurewebsites.net,<app-name>.azurewebsites.net:*
# GDS_DATABASE_DSN must include sslmode=verify-full.
