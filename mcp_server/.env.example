# Development example. The application does not automatically load this file.
GDS_ENVIRONMENT=local

# Secret-bearing values intentionally remain blank. Inject them locally or through
# Azure App Service settings; never commit their values.
GDS_DATABASE_DSN=
GDS_CURSOR_SIGNING_KEY=

# Public OAuth discovery values. These are identifiers, not secrets.
GDS_MCP_PUBLIC_URL=http://localhost:8000/mcp
GDS_ENTRA_TENANT_ID=<entra-tenant-id>
GDS_ENTRA_API_CLIENT_ID=<api-application-client-id>

# Private Azure Blob destination for generated Metadata Snapshots.
GDS_METADATA_SNAPSHOT_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
GDS_METADATA_SNAPSHOT_STORAGE_CONTAINER=snapshots
# Set only for a user-assigned managed identity. Otherwise leave blank.
GDS_METADATA_SNAPSHOT_MANAGED_IDENTITY_CLIENT_ID=

# Production changes:
# GDS_ENVIRONMENT=production
# GDS_MCP_PUBLIC_URL=https://<app-name>.azurewebsites.net/mcp
# GDS_DATABASE_DSN must include sslmode=verify-full.
