# Foundry-enabled template selected by build_uploads.py --agent-provider microsoft_foundry.
# Databricks models remain available from the shared JSON registry.
# Keep credentials behind Databricks App secret resources; never paste them here.
command:
  - uv
  - run
  - --frozen
  - python
  - -m
  - gds_workbench_api.app_process

env:
  - name: NODE_ENV
    value: production
  - name: GDS_WEB_ENVIRONMENT
    value: production
  - name: GDS_WEB_STATIC_DIR
    value: web_app/frontend/dist
  - name: GDS_WEB_AGENT_EXECUTION_MODE
    value: remote
  - name: GDS_WEB_DATABRICKS_EXECUTION_MODE
    value: remote
  - name: GDS_WEB_DATABASE_DSN
    valueFrom: postgres-dsn
  - name: GDS_WEB_CURSOR_SIGNING_KEY
    valueFrom: cursor-signing-key
  - name: GDS_WEB_ENTRA_TENANT_ID
    valueFrom: entra-tenant-id
  - name: GDS_WEB_DATABRICKS_ENVIRONMENT_CODE
    valueFrom: databricks-environment-code
  - name: GDS_WEB_FOUNDRY_OPENAI_BASE_URL
    valueFrom: foundry-openai-base-url
  - name: GDS_WEB_FOUNDRY_API_KEY
    valueFrom: foundry-api-key
