{
  "schema_version": "1.0",
  "commands": {
    "session-init": {"usage": "session-init --root <working-directory> --tenant <TENANT_CODE>", "session_required": false, "mutates": true},
    "status": {"usage": "status --session <session>", "session_required": true, "mutates": false},
    "sql-policy": {"usage": "sql-policy --session <session> --policy never|essential|as_needed", "session_required": true, "mutates": true},
    "readiness": {"usage": "readiness --session <session> --target <workflow-target> [--system-codes <JSON-array>]", "session_required": true, "mutates": false},
    "draft-cache": {"usage": "draft-cache --session <session> --area metadata|model (--id <UUID> --revision <n> --status active|validated | --clear true --expected-id <UUID> --expected-revision <n>)", "session_required": true, "mutates": true},
    "snapshot-refresh": {"usage": "snapshot-refresh --session <session> --area metadata|model", "session_required": true, "mutates": true},
    "task-add": {"usage": "task-add --session <session> --area <area> --title <short-title> --plan <JSON-array>", "session_required": true, "mutates": true},
    "task-plan": {"usage": "task-plan --session <session> --task <ID> --plan <JSON-array> --expected-digest <digest>", "session_required": true, "mutates": true},
    "task-state": {"usage": "task-state --session <session> --task <ID> --state <state>", "session_required": true, "mutates": true},
    "task-stash": {"usage": "task-stash --session <session> --task <ID> --expected-digest <digest>", "session_required": true, "mutates": true},
    "task-restore": {"usage": "task-restore --session <session> --task <ID> --expected-digest <digest>", "session_required": true, "mutates": true},
    "inspect": {"usage": "inspect --session <session> --area metadata|model", "session_required": true, "mutates": false},
    "describe": {"usage": "describe --session <session> --area metadata|model --dataset <name> [--detail compact|full]", "session_required": true, "mutates": false},
    "select": {"usage": "select --session <session> --area metadata|model --dataset <name> --where <JSON-object> --limit <1..200>", "session_required": true, "mutates": false},
    "copy": {"usage": "copy --session <session> --area metadata|model --dataset <name> --where <JSON-object> --expected-digest <digest|empty>", "session_required": true, "mutates": true},
    "upsert": {"usage": "upsert --session <session> --area metadata|model --dataset <name> --record <JSON-object> --expected-digest <digest|empty>", "session_required": true, "mutates": true},
    "upsert-batch": {"usage": "upsert-batch --session <session> --area metadata|model --changes <dataset-to-record-array-JSON> --expected-digest <digest|empty>", "session_required": true, "mutates": true},
    "discard": {"usage": "discard --session <session> --area metadata|model --dataset <name> --key <canonical-key-JSON> --expected-digest <digest>", "session_required": true, "mutates": true},
    "review": {"usage": "review --session <session> --area metadata|model", "session_required": true, "mutates": false},
    "validate": {"usage": "validate --session <session> --area metadata|model", "session_required": true, "mutates": false},
    "accept": {"usage": "accept --session <session> --area metadata|model --digest <digest> [--override true --reason <reason>]", "session_required": true, "mutates": true},
    "reconcile": {"usage": "reconcile --session <session> --area metadata|model --server <server-pending-JSON-object>", "session_required": true, "mutates": false},
    "prepare-stage": {"usage": "prepare-stage --session <session> --area metadata|model --server <server-pending-JSON-object>", "session_required": true, "mutates": true},
    "command-contract": {"usage": "command-contract [--command <name>]", "session_required": false, "mutates": false}
  }
}
