# Copy this file to .env in the uploaded root and replace placeholders.
GDS_NOTEBOOK_POSTGRES_HOST=<postgresql-hostname>
GDS_NOTEBOOK_POSTGRES_PORT=5432
GDS_NOTEBOOK_POSTGRES_DATABASE=<postgresql-database>
GDS_NOTEBOOK_POSTGRES_USER=gds_notebook_runtime
GDS_NOTEBOOK_POSTGRES_PASSWORD=<notebook-runtime-password>
GDS_NOTEBOOK_POSTGRES_SSLMODE=require
GDS_NOTEBOOK_POSTGRES_CONNECT_TIMEOUT_SECONDS=10
GDS_NOTEBOOK_POSTGRES_STATEMENT_TIMEOUT_SECONDS=30
GDS_NOTEBOOK_WORKFLOW_LEASE_SECONDS=30
GDS_NOTEBOOK_WORKFLOW_HEARTBEAT_SECONDS=10
GDS_NOTEBOOK_AGENT_TIMEOUT_SECONDS=120
# Optional for non-agent commands. Agent workflows require an official Foundry
# OpenAI v1 URL plus an API key OR all three Entra fields below; never both.
GDS_NOTEBOOK_FOUNDRY_OPENAI_BASE_URL=
GDS_NOTEBOOK_FOUNDRY_API_KEY=
# Optional confirmed USD token rates keyed by model code; see README. Blank
# preserves tokens and reports Unpriced, without guessing a billing schedule.
GDS_NOTEBOOK_FOUNDRY_PRICING_JSON=
# For Entra auth leave API_KEY blank and uncomment all three placeholders.
# GDS_NOTEBOOK_FOUNDRY_ENTRA_TENANT_ID=<entra-tenant-uuid>
# GDS_NOTEBOOK_FOUNDRY_CLIENT_ID=<entra-application-uuid>
# GDS_NOTEBOOK_FOUNDRY_CLIENT_SECRET=<entra-client-secret>
# Model deployment names and exact model/mode/effort combinations come from
# src/gds_workbench_api/config/agent_capabilities.json.
